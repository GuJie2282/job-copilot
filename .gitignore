# 环境变量（含 API Key，绝对不要提交）
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
build/
dist/

# IDE
.vscode/
.idea/
*.swp

# 系统
.DS_Store
Thumbs.db

# 运行时数据（用户画像/面经/面试会话状态等本地数据，勿提交）
data/*
!data/.gitkeep
# 头像存储（add-resume-avatar 运行时生成，勿提交）
backend/src/data/
# 面试会话状态库（checkpointer 持久化，运行时生成）
backend/interview_checkpoints.db
backend/interview_checkpoints.db-shm
backend/interview_checkpoints.db-wal

# 应用数据库（运行时生成，schema 由 Base.metadata.create_all 初始化，勿提交）
/job_copilot.db
backend/job_copilot.db

# 前端测试产物（Playwright 运行结果，勿提交）
test-results/
web/test-results/

# UI 验证脚本/截图（spike 产物，勿提交；README 用的正式截图放 assets/screenshots/）
.verify/
web/.verify/

# 内网穿透隧道配置（含个人隧道地址，勿提交）
web/.env.cpolar
web/.env.tunnel

# Claude Code 个人配置（含本机路径白名单，勿提交；commands/ skills/ 保留）
.claude/settings.json
.claude/settings.local.json

# 产品文档与设计稿（本地维护，不公开到仓库；界面截图见 assets/screenshots/）
# 这一条同时覆盖了 docs/ 下的个人面试准备材料（与本项目无关）
docs/
