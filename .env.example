# ============================================================
# 求职 Copilot 环境变量模板
#
# 用法：复制成 backend/.env，然后填入自己的 API Key
#   Git Bash:   cp .env.example backend/.env
#   PowerShell: Copy-Item .env.example backend/.env
#
# 注意：backend/.env 已被 .gitignore 排除，不会提交；
#      请勿把真实 Key 写回本模板文件。
# ============================================================

# ===== LLM 配置（唯一必填项是 LLM_API_KEY）=====
# 默认接智谱 GLM（OpenAI 兼容接口，新用户有免费额度，国内可直连）
# 注册获取 Key：https://open.bigmodel.cn/
LLM_API_KEY=your_key_here

# 接口地址（填了以这里为准；不填则按下面的模型名自动匹配官方地址）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 分层选模：把任务按"延迟敏感 / 质量敏感"分给不同档位的模型，兼顾成本与效果
#   LLM_MODEL        快档 —— 延迟敏感任务：答题评估、对话
#   LLM_MODEL_STRONG 主力档 —— 质量敏感任务：出题、复盘、简历与 JD 解析
LLM_MODEL=glm-4-flash
LLM_MODEL_STRONG=glm-4.5

# ===== 想换服务商？只改上面三行（LLM_BASE_URL + 两个模型名）+ Key，代码不用动 =====
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com
#           LLM_MODEL=deepseek-chat              LLM_MODEL_STRONG=deepseek-chat
# OpenAI:   LLM_BASE_URL=https://api.openai.com/v1
#           LLM_MODEL=gpt-4o-mini                LLM_MODEL_STRONG=gpt-4o-mini
# 通义:     LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#           LLM_MODEL=qwen-plus                  LLM_MODEL_STRONG=qwen-plus

# ===== 服务配置 =====
# 端口必须是 8001：前端 vite 代理写死指向 8001（见 web/vite.config.ts），改了前端就连不上
PORT=8001
HOST=0.0.0.0
# 前端地址（CORS 白名单，本地开发保持默认即可）
FRONTEND_URL=http://localhost:3000
# 运行环境：development 时注册验证码会打印到后端控制台，便于本地体验
ENV=development
ENVIRONMENT=development

# ===== 认证 =====
# 本地开发用默认值即可；上线必须换成强随机字符串
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-please-change-before-deploy-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_REFRESH_TOKEN_DAYS=30

# ===== 数据库 =====
# 默认 SQLite，文件自动生成在 backend/job_copilot.db，本地无需改动
# DATABASE_URL=sqlite:///./job_copilot.db

# ===== 语音转写（faster-whisper，本地推理，音频不出服务器）=====
# 首次使用会自动下载模型：tiny≈75MB / small≈500MB（默认，均衡）/ medium≈1.5GB（更准但更慢）
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# WHISPER_LANGUAGE=zh
# WHISPER_COMPUTE=int8
