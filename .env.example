# ===== LLM 配置 =====
# 默认用 DeepSeek（OpenAI 兼容接口，国内可直连，性价比高）
# 注册并获取 API Key：https://platform.deepseek.com/

LLM_API_KEY=your_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash

# ===== 想换其他模型，改上面三行即可 =====
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
# 通义:    LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
# 智谱:    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   LLM_MODEL=glm-4-flash
